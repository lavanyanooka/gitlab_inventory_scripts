# ===========================================================================
# GitLab Inventory Scripts — example environment variables
# ===========================================================================
#
# 1. Copy this file to ".env" in the same directory (the workspace root).
# 2. Replace the placeholder values with your own.
# 3. Run the scripts — they auto-load .env via python-dotenv.
#
# Notes
# -----
# * Real shell environment variables ALWAYS take precedence over .env, so
#   you can override individual values from the terminal without editing
#   the file.
# * Lines starting with "#" are comments and ignored.
# * Quote values that contain spaces:  VAR="some value"
# * Never commit your real .env to git (see .gitignore).
# ===========================================================================


# --- Authentication --------------------------------------------------------
# Use EITHER GITLAB_TOKEN (single PAT) OR GITLAB_TOKENS (comma-separated
# pool of PATs). If both are set, GITLAB_TOKENS wins.
#
# Token scopes required: read_api  (plus read_repository for private repos)
#
# IMPORTANT — for real parallel throughput, each PAT in GITLAB_TOKENS must
# belong to a *different* GitLab user (or service account). GitLab applies
# its primary rate limit per user, not per token, so 3 PATs on the same
# user share one budget.

GITLAB_TOKEN=glpat-REPLACE_WITH_YOUR_TOKEN_xxxxxxxxxxxx

# GITLAB_TOKENS=glpat-aaaaaaaaaaaaaaaaaaaa,glpat-bbbbbbbbbbbbbbbbbbbb,glpat-cccccccccccccccccccc


# --- Target group ----------------------------------------------------------
# Group full path (use "parent/child" for subgroups) or numeric ID.
# Required for the repo inventory script (repo_inventory_scripts/gitlab.py)
# unless --group is passed on the CLI.

GITLAB_GROUP=my-group


# --- GitLab instance -------------------------------------------------------
# Defaults to https://gitlab.com when this line is removed or commented out.

# GITLAB_URL=https://gitlab.example.com


# --- Optional: GitHub token ------------------------------------------------
# Read by repo_inventory_scripts/gitlab.py so it can be re-exported for
# sibling scripts. Not consumed by the inventory itself.

# GITHUB_TOKEN=ghp_REPLACE_WITH_YOUR_TOKEN_xxxxxxxxxxxx
