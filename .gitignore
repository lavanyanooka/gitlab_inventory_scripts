# Secrets — never commit
.env
.env.local
.token
gl-migrate.conf

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Resume / checkpoint state (regenerable; may leak project IDs)
.processed_projects
.processed_pipelines

# Excel lock files
~$*.csv
~$*.xlsx

# Locked-file backup outputs (auto-generated by gitlab.py)
**/data/*_backup_*.csv

# Generated migration artifacts
.tmp_*.py
*.log
container_migration_report.json
package_migration_scripts/inventory/*.xlsx
package_migration_scripts/logs/
package_migration_scripts/reports/

# IDE
.vscode/
.idea/
*.swp
